<Window
    x:Class="GeradorOlt.Apresentacao.JanelaPrincipal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:GeradorOlt.Apresentacao.Telas"
    Width="1240"
    Height="800"
    MinWidth="960"
    MinHeight="660"
    Background="{StaticResource BackgroundBrush}"
    Foreground="{StaticResource TextBrush}"
    Icon="Assets/icone.ico"
    WindowStartupLocation="CenterScreen">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Title" Value="OLT Script Console" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Title" Value="OLT Script Console — alterações não salvas" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding GenerateCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="OLT SCRIPT CONSOLE" />
                            <Border
                                Margin="10,1,0,0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceSoftBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding ApplicationVersion, StringFormat=v{0}}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{StaticResource SubtleTextBrush}"
                            Text="ZTE TITAN  /  PROVISIONAMENTO GPON" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Iniciar nova configuração"
                        Command="{Binding NewScenarioCommand}"
                        Content="Nova configuração"
                        ToolTip="Descartar o cenário atual e começar outro"
                        Style="{StaticResource TextButtonStyle}" />
                    <Button
                        AutomationProperties.Name="Importar perfil de configuração"
                        Margin="4,0,0,0"
                        Command="{Binding LoadProfileCommand}"
                        Content="Importar perfil..."
                        ToolTip="Abrir um perfil JSON existente"
                        Style="{StaticResource BaseButtonStyle}" />
                    <Button
                        AutomationProperties.Name="Abrir informações sobre o aplicativo"
                        Margin="4,0,0,0"
                        Command="{Binding AboutCommand}"
                        Content="Sobre"
                        Style="{StaticResource TextButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="360" MaxWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <views:PainelConfiguracao Grid.Column="0" />
            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWE"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ShowsPreview="True" />
            <views:PainelVisualizacaoScript Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
